# ==========================================
# Application Environment Variables
# ==========================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pfe
DB_USERNAME=root
DB_PASSWORD=root

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# File Uploads
UPLOAD_DIR=uploads/cv

# Mail Configuration (Gmail SMTP or Mailtrap)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# CORS Settings (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost,http://127.0.0.1:4200,http://127.0.0.1:80
